# ------------------------------------------------------------------------------
# STEP 2: Configuration — API Key and Target Cities
# ------------------------------------------------------------------------------
# Your OpenAQ v3 API key. This is used as a header in every API request.
API_KEY  <- "935902a5d02d71e674c1f6092a6f79dffc5f208f6d58161841ae5694e814445d"
BASE_URL <- "https://api.openaq.org/v3"
# The four pollutants we want from OpenAQ
# These are the exact parameter names used in OpenAQ's API
POLLUTANTS <- c("pm25", "pm10", "no2", "so2")
# City metadata: name (must match OpenAQ city names), and center coordinates
cities_df <- data.frame(
name = c("Delhi", "Chennai", "Bangalore"),
lat  = c(28.6139,  13.0827,  12.9716),
lon  = c(77.2090,  80.2707,  77.5946),
stringsAsFactors = FALSE
)
cat("=== STEP 2 COMPLETE: API and cities configured ===\n\n")
# ------------------------------------------------------------------------------
# STEP 3: Helper Function — Safe API GET Request
# ------------------------------------------------------------------------------
# This wraps httr::GET() to handle network errors and bad HTTP responses
# without crashing the entire script. Returns NULL on failure.
safe_api_get <- function(endpoint, api_key, query_params = list()) {
full_url <- paste0(BASE_URL, endpoint)
tryCatch({
response <- httr::GET(
url     = full_url,
httr::add_headers("X-API-Key" = api_key),
query   = query_params,
httr::timeout(30)
)
if (httr::status_code(response) == 200) {
# Parse JSON text to R list
jsonlite::fromJSON(httr::content(response, "text", encoding = "UTF-8"),
flatten = TRUE)
} else {
warning(sprintf("API returned HTTP %d for: %s",
httr::status_code(response), full_url))
NULL
}
}, error = function(e) {
warning(paste("Request failed:", e$message))
NULL
})
}
cat("=== STEP 3 COMPLETE: Helper function defined ===\n\n")
# ------------------------------------------------------------------------------
# STEP 4: Fetch Monitoring Station Locations from OpenAQ
# ------------------------------------------------------------------------------
# For each city, we query OpenAQ to get all active monitoring stations
# including their latitude/longitude coordinates.
cat("--- STEP 4: Fetching station locations ---\n")
fetch_city_locations <- function(city_name, api_key) {
cat(sprintf("  Fetching stations for: %s\n", city_name))
result <- safe_api_get(
endpoint     = "/locations",
api_key      = api_key,
query_params = list(
country_id = "IN",   # India
city       = city_name,
limit      = 200,
page       = 1
)
)
# Return NULL if API call failed or no results
if (is.null(result) || is.null(result$results) || length(result$results) == 0) {
warning(sprintf("No stations found for %s", city_name))
return(NULL)
}
locs <- result$results
# Safely extract coordinates — they may be nested differently
lat_vals <- tryCatch(locs$coordinates.latitude,  error = function(e) rep(NA, nrow(locs)))
lon_vals <- tryCatch(locs$coordinates.longitude, error = function(e) rep(NA, nrow(locs)))
data.frame(
location_id   = locs$id,
location_name = locs$name,
city          = city_name,
lat           = as.numeric(lat_vals),
lon           = as.numeric(lon_vals),
stringsAsFactors = FALSE
)
}
# Run for all 3 cities and combine into one data frame
all_locations <- dplyr::bind_rows(
lapply(cities_df$name, fetch_city_locations, api_key = API_KEY)
)
# Drop stations with missing coordinates — we can't map those
all_locations <- all_locations[!is.na(all_locations$lat) &
!is.na(all_locations$lon), ]
cat(sprintf("\n  Total valid stations found: %d\n", nrow(all_locations)))
cat("=== STEP 4 COMPLETE: Locations fetched ===\n\n")
# ------------------------------------------------------------------------------
# STEP 5: Fetch Pollutant Measurements for Each Station (2023)
# ------------------------------------------------------------------------------
# For each station, we request measurements for all 4 pollutants
# for the full year 2023. OpenAQ returns measurements page by page;
# we use limit=1000 to get as many readings as possible per station.
cat("--- STEP 5: Fetching pollutant measurements (this may take a few minutes) ---\n")
fetch_station_measurements <- function(location_id, city_name, api_key) {
station_data <- list()
for (pollutant in POLLUTANTS) {
result <- safe_api_get(
endpoint     = paste0("/locations/", location_id, "/measurements"),
api_key      = api_key,
query_params = list(
parameter = pollutant,
date_from = "2023-01-01T00:00:00Z",
date_to   = "2023-12-31T23:59:59Z",
limit     = 1000
)
)
if (!is.null(result) && !is.null(result$results) &&
length(result$results) > 0) {
meas <- result$results
# Extract date string from nested list safely
date_vals <- tryCatch(
as.Date(substr(meas$date.utc, 1, 10)),
error = function(e) rep(as.Date(NA), length(meas$value))
)
station_data[[pollutant]] <- data.frame(
location_id = location_id,
city        = city_name,
parameter   = pollutant,
value       = as.numeric(meas$value),
date        = date_vals,
stringsAsFactors = FALSE
)
}
# Pause briefly to respect OpenAQ rate limits (100 req/min on free tier)
Sys.sleep(0.25)
}
if (length(station_data) > 0) dplyr::bind_rows(station_data) else NULL
}
# Iterate over every station
all_measurements_list <- vector("list", nrow(all_locations))
for (i in seq_len(nrow(all_locations))) {
cat(sprintf("  Station %d / %d : %s (%s)\n",
i, nrow(all_locations),
all_locations$location_name[i],
all_locations$city[i]))
all_measurements_list[[i]] <- fetch_station_measurements(
location_id = all_locations$location_id[i],
city_name   = all_locations$city[i],
api_key     = API_KEY
)
}
