# ==============================================================================
# ASSESSMENT 3: Air Pollution Mapping in India
# ==============================================================================
# Dataset  : OpenAQ API v3 (https://openaq.org)
# Cities   : Delhi, Chennai, Bangalore
# Pollutants: PM2.5, PM10, NO2, SO2
# Period   : January – December 2023
# Techniques: IDW, Kriging, Heatmaps, Temporal Analysis
# Output   : Interactive AQI maps, Choropleth, Temporal plots
# ==============================================================================
# ==============================================================================
# HOW TO GET THE DATASET
# ==============================================================================
# OpenAQ provides a free REST API. Your API key is already embedded below.
# No file download is needed — data is fetched directly via API calls.
#
# Optional: To explore data manually, visit https://explore.openaq.org
# and search for Delhi / Chennai / Bangalore to see available stations.
# ==============================================================================
# ------------------------------------------------------------------------------
# STEP 1: Install and Load Required Libraries
# ------------------------------------------------------------------------------
# Run install.packages() lines only ONCE if packages are not already installed.
required_packages <- c(
"httr",            # Makes HTTP requests to the OpenAQ API
"jsonlite",        # Parses JSON responses from the API
"dplyr",           # Data manipulation (filter, group_by, summarise)
"tidyr",           # Reshaping data (pivot_wider / pivot_longer)
"lubridate",       # Working with date/time columns
"ggplot2",         # Static plots (temporal trends, raster viz)
"sf",              # Spatial vector data (points, polygons)
"gstat",           # IDW and Kriging spatial interpolation
"sp",              # Spatial objects — required by gstat
"leaflet",         # Interactive web maps
"leaflet.extras",  # Heatmap layer for leaflet
"tmap",            # Thematic mapping
"RColorBrewer",    # Color palettes
"scales",          # Formatting numbers and colors
"htmlwidgets"      # Saving interactive HTML maps
)
# Automatically install any missing packages
options(timeout = max(1000, getOption("timeout")))
new_pkgs <- required_packages[!(required_packages %in% installed.packages()[, "Package"])]
if (length(new_pkgs) > 0) {
message("Installing missing packages: ", paste(new_pkgs, collapse = ", "))
# Install CRAN packages
cran_pkgs <- new_pkgs[new_pkgs != "leaflet.extras"]
if(length(cran_pkgs) > 0) install.packages(cran_pkgs, dependencies = TRUE, repos = "http://cran.us.r-project.org")
# Install github package
if("leaflet.extras" %in% new_pkgs) {
if(!require(remotes)) install.packages("remotes", repos = "http://cran.us.r-project.org")
remotes::install_github("bhaskarvk/leaflet.extras")
}
}
# Ensure rlang is at least 1.1.7, which is required by newer dplyr versions
if (packageVersion("rlang") < "1.1.7") {
message("Updating rlang to >= 1.1.7...")
install.packages("rlang", repos = "http://cran.us.r-project.org")
}
# Load all packages silently
invisible(lapply(required_packages, library, character.only = TRUE))
install.packages(c("nlme", "rpart", "sourcetools"))
